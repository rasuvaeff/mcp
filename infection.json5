{
    "$schema": "vendor/infection/infection/resources/schema.json",
    "source": {
        "directories": ["src"]
    },
    "logs": {
        "text": "php://stderr",
        "summary": "build/infection-summary.log"
    },
    "testFramework": "testo",
    // `composer mutation` counts uncovered code (--with-uncovered). What is
    // left is listed here, each entry with the reasoning that makes it
    // unkillable. No ignores: Infection still generates and runs every one
    // of them, this is a record, not a suppression.
    //
    // Output-neutral rewrites:
    //    - Identity/StaticSecretResolver.php UnwrapArrayValues: $list is only
    //      iterated, never indexed, and nothing exposes it.
    //    - Session/PrivateFileSessionStore.php UnwrapArrayValues (Not
    //      Covered): the SDK's FileSessionStore::gc() already returns a list.
    //    - Interceptor/ResponseSizeLimitInterceptor.php LessThanOrEqualTo: at
    //      $size === $maxBytes Utf8::cut() returns its input untouched.
    //    - Utf8.php DecrementInteger (`default => 1` -> 0): reached only for
    //      an ASCII lead byte, where both comparisons are always true.
    //    - McpServerFactory.php PlusEqual: every term is >= 0 and only
    //      `=== 0` is read.
    //    - McpServerFactory.php LogicalOrAllSubExprNegation: a pass-through
    //      reference handler with nothing configured behaves as no handler.
    //    - McpListCommand.php ReturnRemoval (arguments()): a non-array schema
    //      renders '' with or without the early return.
    //    - ToolResultTextFormatter.php ReturnRemoval: the general path ends in
    //      json_encode([]), the same '[]'. Mirrors the SDK line for line.
    //
    // Unreachable, or no safe way to reach:
    //    - OAuth/OAuthComponentFactory.php Throw_ (Not Covered,
    //      `firebase/php-jwt` missing): a dev dependency, always installed.
    //    - OutputBufferReleasingStream.php ReturnRemoval (Not Covered): needs a
    //      non-removable output buffer left in the shared test process.
    //    - Testing/McpTester.php speaks to a real SDK server: TrueValue (only
    //      isset() reads the map), LogicalAnd (a non-array `error` no SDK
    //      handler produces), ReturnRemoval (Not Covered: an empty body
    //      answers only a notification, and request() always sends an id).
    //
    // Mutants that are only ever "Timed Out" are infinite loops by
    // construction (Utf8 backing-over loop, McpTester::listAll()): the original code is what stops them.
    // Unit only: every package declares a Benchmarks suite (testo.php), and Infection's initial
    // test run would execute it. A timing-sensitive benchmark fails under host load and aborts
    // the whole mutation run (result, 2026-11-03). Benchmarks mutate nothing and kill nothing.
    "testFrameworkOptions": "--suite=Unit",
    "minMsi": 97,
    "mutators": {
        "@default": true,
        // Constructor/method parameter declarations with a default value
        // (`private int $x = 100,`, `bool $strict = false,`): the mutant sits on a
        // signature line with no executable opcode under pcov, so it is reported Not
        // Covered whatever the tests do. Only a type-prefixed `$name = default,` line
        // matches; a body line cannot (no type before the variable). Do NOT add ^ or $:
        // Infection wraps the pattern as ^-\s*REGEX$ over the removed diff line.
        // Verified 2026-11-01 by diffing the survivor lists with and without it:
        // bulkhead 6, circuit-breaker 13, json-ld 19 mutants removed, all of them
        // such signature lines; Escaped and Timed Out unchanged.
        "global-ignoreSourceCodeByRegex": [
            "(?:(?:private|protected|public|readonly)\\s+)*\\??[A-Za-z_\\\\][\\w\\\\|]*\\s+\\$\\w+\\s*=\\s*[^,;]+,"
        ],
        // Off: with --with-uncovered a PublicVisibility mutant sits on a parameterless
        // method's signature line, which has no executable opcode under pcov/xdebug,
        // so it is reported Not Covered and can never be killed, whatever #[Covers]
        // says. Measured on pinned-http-client 2026-11-01: 4 of 4 such mutants were
        // Not Covered, none killed.
        "PublicVisibility": false,
        // Off for the same reason: a ProtectedVisibility mutant on a protected method's
        // signature line is Not Covered and cannot be killed. Measured on
        // understudy-phpunit 2026-11-01: 4 of 4 such mutants were Not Covered.
        "ProtectedVisibility": false
    }
}
